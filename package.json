{
  "name": "nctd-manifest-parser",
  "version": "0.1.0",
  "private": true,
  "description": "NCTD Manifest Parser WebApp: converts NCTD trip manifests (Viajes) into TOBI-compatible CSV files following config/rules/nctd_manifest_parser_rules_v1.3.0.json.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "tabulator-tables": "^6.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
