# Copy to .env (git ignores it) and run: npm run dev:db
# Catalog in DynamoDB (rules v2.8.3, CATALOG-STORAGE-001). Use the stage table on your computer.
CATALOG_STORE=dynamodb
CATALOG_TABLE=nctd-passengers-stage
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Key typed in the App to read or change the catalog
CATALOG_ACCESS_KEY=
